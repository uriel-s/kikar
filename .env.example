# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) -------------------------------------------------
# Local docker-compose default. In AWS, point this at your RDS instance.
DATABASE_URL=postgresql://kikar:kikar@localhost:5432/kikar?schema=public

# RDS terminates TLS; the local docker-compose Postgres does not.
DATABASE_SSL=false

# Verify the database's TLS certificate. Leave this alone unless your Postgres
# is fronted by a private CA — turning it off keeps traffic encrypted but stops
# checking who is on the other end.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- Firebase Admin (server-side token verification) ----------------------
# Identity stays on Firebase Auth; application data lives in PostgreSQL.
# Supply the service account as inline JSON (preferred for containers/CI)
# or as a path to a mounted key file. Set exactly one.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Firebase Storage bucket used for avatar uploads.
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# --- Client ---------------------------------------------------------------
# Base URL the browser uses to reach the API.
REACT_APP_API_URL=http://localhost:5000

# Firebase web config. These are public by design — they identify the project,
# they do not authorize access. Access control lives in Firebase Auth rules
# and in this API's own authorization checks.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
