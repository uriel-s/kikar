# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) -------------------------------------------------
# Local docker-compose default. In AWS, point this at your RDS instance.
DATABASE_URL=postgresql://kikar:kikar@localhost:5432/kikar?schema=public

# Only needed on a pooled host such as Neon, where DATABASE_URL above is the
# *pooled* address (it has "-pooler" in the hostname). Migrations cannot run
# through a transaction-mode pooler, so they use this direct address instead.
# Leave empty for a local or RDS database, where DATABASE_URL is already direct.
DIRECT_URL=

# RDS terminates TLS; the local docker-compose Postgres does not. Neon always
# requires TLS, so set this to true there.
DATABASE_SSL=false

# Verify the database's TLS certificate. Leave this alone unless your Postgres
# is fronted by a private CA — turning it off keeps traffic encrypted but stops
# checking who is on the other end.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- Firebase Admin (server-side token verification) ----------------------
# Identity stays on Firebase Auth; application data lives in PostgreSQL.
# Supply the service account as inline JSON (preferred for containers/CI)
# or as a path to a mounted key file. Set exactly one.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Firebase Storage bucket used for avatar uploads.
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# --- Client ---------------------------------------------------------------
# Vite reads env files from apps/client/, not the repo root — copy this
# section into apps/client/.env (see apps/client/.env for the file Vite
# actually loads).

# Base URL the browser uses to reach the API.
VITE_API_URL=http://localhost:5000

# Firebase web config. These are public by design — they identify the project,
# they do not authorize access. Access control lives in Firebase Auth rules
# and in this API's own authorization checks.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
