# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
build/
dist/
*.tsbuildinfo

# Environment — never commit real values, only .env.example
.env
.env.*
!.env.example

# Secrets — service account keys, certificates, credentials
*serviceAccountKey*.json
*service-account*.json
*firebase-adminsdk*.json
*.pem
*.key
*.p12

# Test output
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Prisma generated client
apps/server/src/generated/

# Claude Code working files — per-run state, regenerated every session
.dev-log.md
.dev-plan.md
.dev-plan.*.done.md
.dev-state.md
.work-context.md

# /dev session artifacts (per-run logs and state snapshots)
.dev-archive/

# Personal Claude Code tooling. checks.sh and test-baseline are deliberately
# NOT ignored: checks.sh is this project's definition of "green" — it mirrors
# .github/workflows/ci.yml and CLAUDE.md points at it — and the baseline is the
# refactor's safety net. Everything else under .claude/ is per-developer.
.claude/*
!.claude/checks.sh
!.claude/test-baseline
!.claude/audit-baseline
